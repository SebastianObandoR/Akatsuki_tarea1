    print("Esperamos que hayas aprendido");
    print("¡Hasta pronto!");
}
// Funciones Completadas por julian, a y b de categoria de Numeros

//Inicio Funcion a Numeros
func ordenaNumeros() : bool{
    let numeros : list<int> = [];
    let i: int = 0;
    for (i = 0; i<4; i++) {
        numeros.append(random(1,99));
    }

    print("Estos son los numeros: ${numeros[0]}, ${numeros[1]},${numeros[2]}, ${numeros[3]}");
    print("Ordenalos de |MAYOR| a |MENOR|");

    let correcto: list<int> = numeros.copy();
    let j: int=0;
    let k: int=0;
    let temp: int = 0;
    for (j = 0; j< 4; j++) {
        for (k = 0;k<3-j;k++){
            if (correcto[k] < correcto[k+1]) {
                temp = correcto[k];
                correcto[k] = correcto [k+1];
                correcto[k+1] = temp;
            }
        
        }
    }

    let respuesta : list <int> = [];
    for (i=0; i <4; i++) {
        let valor: int = input("Posicion ${i+1}: ").to_int();
        respuesta.append(valor);
    }

    let gano: bool = true;
    for(i=0; i< 4; i++){
        if (respuesta[i] != correcto[i]) {
            gano = false;
        }
    }

    if (gano) {
        print("Felicidades, lo ordenaste correctamente!!");
    
    }else{
        print("No era el orden correcto, Intentalo nuevamente");
    }

    return gano;
    
}
//Fin de la a de numeros


//inicio de la B de Numeros

func mayorMenor() : bool {
    let a : int = random(1,99);
    let b: int = random(1,99);
    let c: int = random(1,99);
    let modo : int=random(1,2);
    let gano : bool= false;

    print("Los numeros son : A=${a}, B=${b}, C=${c}");

    if (modo == 1) {
        print("Cual letra tiene el numero MAYOR? (A|B|C)");
    }else {
        print("Cual letra tiene el numero MENOR? (A|B|C)");
    }

    let respuesta:string = input ("Tu respuesta: ");

    let mayor: int=a;
    let letraMayorLow: string="a";
    let letraMayor: string = "A";
    if (b> mayor) {mayor = b; letraMayor = "B";letraMayorLow = "b";}
    if (c>mayor) { mayor = c; letraMayor ="C";letraMayorLow = "c"; }

    let menor : int = a;
    let letraMenor: string = "A";
    let letraMenorLow: string ="a";
    if (b < menor) {menor= b; letraMenor ="B";letraMenorLow = "b";}
    if (c< menor) { menor = c; letraMenor ="C";letraMenorLow = "c";}

    if(modo ==1) {
        gano= (respuesta == letraMayor) || (respuesta == letraMayorLow);
    }else{
        gano = (respuesta == letraMenor) || (respuesta == letraMenorLow);
    }

    if(gano) {
        print("Felicidades, ganaste");
    }else {
        print("No era esa, intenta de nuevo");
    }
    
}

   



main();