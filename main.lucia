    print("Presiona Enter para continuar...");
    input();

    print("");
    print("Completa la palabra:");
    print("C _ S A");
    print("Digite la letra que falta:");

    let respuesta1: string = input().trim().upper();

    if (respuesta1 == "A") {
        print("¡Excelente! Respuesta correcta");
    } else {
        print("Respuesta incorrecta ¡Intentalo nuevamente!");
    }

    print("");
    print("------------------------------------");
    print("Palabra completa: GATO");
    print("Presiona Enter para continuar...");
    input();

    print("");
    print("Completa la palabra:");
    print("G _ T O");
    print("Digite la letra que falta:");

    let respuesta2: string = input().trim().upper();

    if (respuesta2 == "A") {
        print("¡Excelente! Respuesta correcta");
    } else {
        print("Respuesta incorrecta ¡Intentalo nuevamente!");
    }

    print("");

   
    print("------------------------------------");
    print("Palabra completa: MESA");
    print("Presiona Enter para continuar...");
    input();

    print("");
    print("Completa la palabra:");
    print("M E _ A");
    print("Digite la letra que falta:");

    let respuesta3: string = input().trim().upper();

    if (respuesta3 == "S") {
        print("¡Excelente! Respuesta correcta.");
    } else {
        print("Respuesta incorrecta. ¡Intentalo nuevamente!");
    }

    print("");
    print("Has terminado Completa la palabra");
    print("");
}


func pendiente(nombre: string): void {
    print("");
    print("------------------------------------");
    print(nombre);
    print("Juego pendiente de implementar");
    print("------------------------------------");
    print("");
}



func menuLetras(): void {
    let activo: bool = true;

    while (activo) {
        print("");
        print("====================================");
        print("              LETRAS");
        print("====================================");
        print("1. Bosque de letras");
        print("2. Completa la palabra");
        print("3. Letra intrusa");
        print("0. Volver");
        print("");
        print("Seleccione una opcion:");

        let entrada: string = input().trim();

        if (entrada.is_numeric()) {
            let opcion: int = entrada.to_int();

            switch (opcion) {
                case 1: bosqueDeLetras();
                case 2: completaLaPalabra();
                case 3: pendiente("Letra intrusa");
                case 0: activo = false;
                default: print("Opcion invalida Intente nuevamente.");
            }
        } else {
            print("Debe ingresar un numero");
        }
    }
}

