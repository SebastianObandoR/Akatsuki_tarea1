func main(): void {
    let ejecutando: bool = true;

    print("");
    print("----------");
    print("    MINICOMPUTADORA DIDACTICA");
    print("----------");
    print("");
    print("¡Bienvenido!");
    print("Aprende y diviertete con nuestras");
    print("actividades educativas");

    while (ejecutando) {
        print("");
        print("----------");
        print("          MENU PRINCIPAL");
        print("----------");
        print("1. Letras");
        print("2. Numeros");
        print("3. Logica");
        print("4. Juegos");
        print("5. Salir");
        print("");
        print("Seleccione una opcion:");

        let entrada: string = input().trim();

        if (entrada.is_numeric()) {
            let opcion: int = entrada.to_int();

            switch (opcion) {
                case 1: menuLetras();
                case 2: menuNumeros();
                case 3: menuLogica();
                case 4: menuJuegos();
                case 5: ejecutando = false;
                default: print("Opcion invalida Intente nuevamente.");
            }
        } else {
            print("Debe ingresar un numero");
        }
    }

    print("");
    print("----------");
    print("      ¡GRACIAS POR JUGAR!");
    print("----------");
    print("Esperamos que hayas aprendido");
    print("¡Hasta pronto!");
}


main();